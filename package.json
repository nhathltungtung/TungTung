{
  "name": "tungtung",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:features": "node scripts/verify-all-features.mjs",
    "doctor": "node scripts/verify-all-features.mjs",
    "generate:crud": "node scripts/generate-crud.mjs",
    "db:start": "docker compose -f ./supabase-docker/docker-compose.yml -f ./supabase-docker/docker-compose.override.yml up -d",
    "db:stop": "docker compose -f ./supabase-docker/docker-compose.yml -f ./supabase-docker/docker-compose.override.yml down",
    "db:status": "docker compose -f ./supabase-docker/docker-compose.yml -f ./supabase-docker/docker-compose.override.yml ps",
    "db:logs": "docker compose -f ./supabase-docker/docker-compose.yml -f ./supabase-docker/docker-compose.override.yml logs -f",
    "db:reset": "docker compose -f ./supabase-docker/docker-compose.yml -f ./supabase-docker/docker-compose.override.yml down -v && docker compose -f ./supabase-docker/docker-compose.yml -f ./supabase-docker/docker-compose.override.yml up -d"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
